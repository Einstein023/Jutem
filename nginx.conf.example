# ==============================================================================
# Nginx Configuration Example for JUTEM Global Resources
# Place in /etc/nginx/sites-available/jutem and link to sites-enabled
# ==============================================================================

# 1. Redirect HTTP to HTTPS (Port 80 -> Port 443)
server {
    listen 80;
    listen [::]:80;
    server_name jutemglobal.com www.jutemglobal.com;
    return 301 https://jutemglobal.com$request_uri;
}

# 2. Redirect WWW to Non-WWW on HTTPS (Prevent Duplicate URLs)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.jutemglobal.com;

    # SSL Certificates (Let's Encrypt / Certbot)
    ssl_certificate /etc/letsencrypt/live/jutemglobal.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jutemglobal.com/privkey.pem;

    return 301 https://jutemglobal.com$request_uri;
}

# 3. Main Server Block (Canonical HTTPS)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name jutemglobal.com;

    root /var/www/jutem/dist;
    index index.html;

    # SSL Certificates & Modern TLS Protocols
    ssl_certificate /etc/letsencrypt/live/jutemglobal.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jutemglobal.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # Security & HSTS Headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    # Static Asset Caching
    location ~* \.(?:ico|css|js|gif|jpe?g|png|svg|webp|woff2?|ttf|eot|mp4)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # Remove trailing slashes to prevent duplicate URLs (except root)
    rewrite ^/(.+)/$ /$1 permanent;

    # Strip /index.html from URL
    if ($request_uri ~* "^(.*/)index\.html$") {
        return 301 $1;
    }

    # SPA Routing (Fall back to index.html for React client routes)
    location / {
        try_files $uri $uri/ /index.html;
    }
}
